{
  "entities": {
    "UserPublic": {
      "title": "UserPublic",
      "description": "Public profile metadata for a registered Decompress user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 120 },
        "accountType": { "type": "string", "enum": ["personal", "corporate"] },
        "companyName": { "type": "string", "maxLength": 160 }
      },
      "required": ["uid", "name", "accountType"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private PII and notification preferences for a registered Decompress user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 40 },
        "googleLinked": { "type": "boolean" },
        "emailVerified": { "type": "boolean" },
        "promotionalEmailsOptIn": { "type": "boolean" }
      },
      "required": ["uid", "email", "googleLinked", "emailVerified"]
    },
    "Favourite": {
      "title": "Favourite",
      "description": "Saved venue bookmark belonging to a verified registered user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "venueId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAtUtc": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "userId", "venueId", "createdAtUtc"]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "Local mirror of a fintech-backed customer wallet balance (account-only, WALLET_ENABLED).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "balanceMinor": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "providerAccountRef": { "type": "string", "maxLength": 120 },
        "updatedAtUtc": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "userId", "balanceMinor", "currency", "providerAccountRef", "updatedAtUtc"]
    },
    "WalletTransaction": {
      "title": "WalletTransaction",
      "description": "Mirror record of a wallet funding, booking payment, refund, or reversal.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "walletId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["funding", "booking_payment", "refund", "reversal"] },
        "amountMinor": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "enum": ["pending", "succeeded", "failed", "refunded", "reversed"] },
        "providerReference": { "type": "string", "maxLength": 120 },
        "bookingReference": { "type": "string", "maxLength": 20 },
        "description": { "type": "string", "maxLength": 300 },
        "createdAtUtc": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "walletId", "userId", "type", "amountMinor", "currency", "status", "providerReference", "description", "createdAtUtc"]
    },
    "AdminMember": {
      "title": "AdminMember",
      "description": "Staff role membership document for Decompress admin dashboard.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "staffGroup": { "type": "string", "enum": ["Operations", "Finance", "Content & Support", "Superuser"] }
      },
      "required": ["uid", "email", "staffGroup"]
    },
    "Category": {
      "title": "Category",
      "description": "One of the 7 Decompress venue categories.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100, "pattern": "^[a-z0-9\\-]+$" },
        "description": { "type": "string", "maxLength": 500 },
        "iconName": { "type": "string", "maxLength": 50 },
        "order": { "type": "number" }
      },
      "required": ["id", "name", "slug", "description", "order"]
    },
    "Location": {
      "title": "Location",
      "description": "City, area, and neighbourhood for venue discovery.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "city": { "type": "string", "maxLength": 80 },
        "area": { "type": "string", "maxLength": 80 },
        "neighbourhood": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "city", "area", "neighbourhood"]
    },
    "Facility": {
      "title": "Facility",
      "description": "Venue facility linked to the category slugs it applies to.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 80 },
        "slug": { "type": "string", "maxLength": 80, "pattern": "^[a-z0-9\\-]+$" },
        "applicableCategorySlugs": { "type": "array" }
      },
      "required": ["id", "name", "slug", "applicableCategorySlugs"]
    },
    "ExperienceTag": {
      "title": "ExperienceTag",
      "description": "Activity or experience tag such as salsa, karaoke, or live band.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 80 },
        "slug": { "type": "string", "maxLength": 80, "pattern": "^[a-z0-9\\-]+$" },
        "categorySlugs": { "type": "array" }
      },
      "required": ["id", "name", "slug", "categorySlugs"]
    },
    "Venue": {
      "title": "Venue",
      "description": "Social experience venue listing with indicative Budget Range and facilities.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 160 },
        "slug": { "type": "string", "maxLength": 160, "pattern": "^[a-z0-9\\-]+$" },
        "description": { "type": "string", "maxLength": 3000 },
        "address": { "type": "string", "maxLength": 300 },
        "locationId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "city": { "type": "string", "maxLength": 80 },
        "area": { "type": "string", "maxLength": 80 },
        "neighbourhood": { "type": "string", "maxLength": 100 },
        "setting": { "type": "string", "enum": ["indoor", "outdoor", "rooftop", "beachfront"] },
        "capacity": { "type": "number" },
        "openingHours": { "type": "string", "maxLength": 300 },
        "budgetMinMinor": { "type": "number" },
        "budgetMaxMinor": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "budgetBasis": { "type": "string", "enum": ["per_person", "per_table", "total"] },
        "categorySlugs": { "type": "array" },
        "experienceTags": { "type": "array" },
        "facilitySlugs": { "type": "array" },
        "occasions": { "type": "array" },
        "bookingTypes": { "type": "array" },
        "heroImageUrl": { "type": "string", "maxLength": 4000 },
        "galleryImages": { "type": "array" },
        "confirmedOfferText": { "type": "string", "maxLength": 400 },
        "ratingAverage": { "type": "number" },
        "reviewCount": { "type": "number" },
        "isFeatured": { "type": "boolean" },
        "isPublished": { "type": "boolean" }
      },
      "required": [
        "id", "name", "slug", "description", "address", "locationId",
        "setting", "capacity", "budgetMinMinor", "budgetMaxMinor",
        "currency", "budgetBasis", "isFeatured", "isPublished"
      ]
    },
    "Booking": {
      "title": "Booking",
      "description": "Concierge booking request (guest or signed-in member) with DCP-XXXXXX reference.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reference": { "type": "string", "maxLength": 20, "pattern": "^DCP-[A-Z0-9]{6}$" },
        "status": { "type": "string", "enum": ["pending", "approved", "unavailable", "confirmed", "completed", "cancelled"] },
        "venueId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "venueName": { "type": "string", "maxLength": 160 },
        "venueSlug": { "type": "string", "maxLength": 160, "pattern": "^[a-z0-9\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "guestName": { "type": "string", "maxLength": 120 },
        "guestEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "guestPhone": { "type": "string", "maxLength": 40 },
        "date": { "type": "string", "maxLength": 20 },
        "preferredTime": { "type": "string", "maxLength": 20 },
        "guestCount": { "type": "number" },
        "occasion": { "type": "string", "maxLength": 120 },
        "bookingType": { "type": "string", "enum": ["table", "group", "private_hire"] },
        "specialRequests": { "type": "string", "maxLength": 1500 },
        "eventServiceLevel": { "type": "string", "maxLength": 80 },
        "selectedAddOnIds": { "type": "array" },
        "amountDueMinor": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "cancellationReason": { "type": "string", "maxLength": 500 },
        "reviewToken": { "type": "string", "maxLength": 80 },
        "createdAtUtc": { "type": "string", "maxLength": 40 }
      },
      "required": [
        "id", "reference", "status", "venueId", "venueName", "venueSlug",
        "userId", "guestName", "guestEmail", "guestPhone", "date",
        "preferredTime", "guestCount", "occasion", "bookingType",
        "currency", "createdAtUtc"
      ]
    },
    "BookingStatusHistory": {
      "title": "BookingStatusHistory",
      "description": "Immutable audit entry for every booking status transition.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fromStatus": { "type": "string", "maxLength": 30 },
        "toStatus": { "type": "string", "maxLength": 30 },
        "actor": { "type": "string", "maxLength": 160 },
        "note": { "type": "string", "maxLength": 500 },
        "timestampUtc": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "bookingId", "fromStatus", "toStatus", "actor", "note", "timestampUtc"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Provider-backed payment intent and confirmation record for a booking.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingReference": { "type": "string", "maxLength": 20 },
        "userId": { "type": "string", "maxLength": 128 },
        "provider": { "type": "string", "maxLength": 60 },
        "providerReference": { "type": "string", "maxLength": 120 },
        "amountMinor": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "enum": ["pending", "succeeded", "failed", "refunded", "reversed"] },
        "method": { "type": "string", "enum": ["guest_checkout_link", "wallet", "card_sandbox"] },
        "guestPayToken": { "type": "string", "maxLength": 80 },
        "createdAtUtc": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "bookingId", "bookingReference", "provider", "providerReference", "amountMinor", "currency", "status", "method", "guestPayToken", "createdAtUtc"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Itemised paid invoice issued upon booking confirmation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingReference": { "type": "string", "maxLength": 20 },
        "userId": { "type": "string", "maxLength": 128 },
        "invoiceNumber": { "type": "string", "maxLength": 40 },
        "venueName": { "type": "string", "maxLength": 160 },
        "eventDate": { "type": "string", "maxLength": 20 },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerEmail": { "type": "string", "maxLength": 160 },
        "companyName": { "type": "string", "maxLength": 160 },
        "lineItems": { "type": "array" },
        "discountOrFeeMinor": { "type": "number" },
        "amountPaidMinor": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "enum": ["paid", "refunded"] },
        "issuedAtUtc": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "bookingId", "bookingReference", "invoiceNumber", "venueName", "eventDate", "customerName", "customerEmail", "amountPaidMinor", "currency", "status", "issuedAtUtc"]
    },
    "Settlement": {
      "title": "Settlement",
      "description": "Admin-only commercial reconciliation record per booking (free-form fields, zero formulas, never customer visible).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingReference": { "type": "string", "maxLength": 20 },
        "customerAmountReceivedMinor": { "type": "number" },
        "venueBillAmountMinor": { "type": "number" },
        "venueBillFileName": { "type": "string", "maxLength": 200 },
        "agreedDiscountMinor": { "type": "number" },
        "decompressShareMinor": { "type": "number" },
        "amountPayableToVenueMinor": { "type": "number" },
        "amountRetainedMinor": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "settlementStatus": { "type": "string", "enum": ["unreconciled", "pending_payout", "settled", "disputed"] },
        "settledAtUtc": { "type": "string", "maxLength": 40 },
        "updatedBy": { "type": "string", "maxLength": 160 },
        "updatedAtUtc": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "bookingId", "bookingReference", "customerAmountReceivedMinor", "venueBillAmountMinor", "agreedDiscountMinor", "decompressShareMinor", "amountPayableToVenueMinor", "amountRetainedMinor", "currency", "settlementStatus", "updatedBy", "updatedAtUtc"]
    },
    "EventPlanningRequest": {
      "title": "EventPlanningRequest",
      "description": "Standalone or booking-attached event-planning and coordination request.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reference": { "type": "string", "maxLength": 20 },
        "userId": { "type": "string", "maxLength": 128 },
        "guestName": { "type": "string", "maxLength": 120 },
        "guestEmail": { "type": "string", "maxLength": 160 },
        "guestPhone": { "type": "string", "maxLength": 40 },
        "serviceLevel": { "type": "string", "enum": ["event_planning_assistance", "on_the_day_coordination", "full_planning_and_coordination"] },
        "occasion": { "type": "string", "maxLength": 120 },
        "date": { "type": "string", "maxLength": 20 },
        "location": { "type": "string", "maxLength": 160 },
        "guestCount": { "type": "number" },
        "budgetMinor": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "assistanceNeeded": { "type": "string", "maxLength": 2000 },
        "selectedAddOnIds": { "type": "array" },
        "status": { "type": "string", "enum": ["new", "in_discussion", "quoted", "accepted", "in_progress", "completed", "declined"] },
        "quotedAmountMinor": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1500 },
        "linkedBookingId": { "type": "string", "maxLength": 128 },
        "createdAtUtc": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "reference", "userId", "guestName", "guestEmail", "guestPhone", "serviceLevel", "occasion", "date", "location", "guestCount", "budgetMinor", "currency", "assistanceNeeded", "status", "createdAtUtc"]
    },
    "Review": {
      "title": "Review",
      "description": "Verified customer review tied strictly to a completed booking.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingReference": { "type": "string", "maxLength": 20 },
        "venueId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "venueName": { "type": "string", "maxLength": 160 },
        "reviewerName": { "type": "string", "maxLength": 120 },
        "rating": { "type": "number" },
        "venueFeedback": { "type": "string", "maxLength": 1500 },
        "experienceFeedback": { "type": "string", "maxLength": 1500 },
        "isVerified": { "type": "boolean" },
        "isHidden": { "type": "boolean" },
        "createdAtUtc": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "bookingId", "bookingReference", "venueId", "venueName", "reviewerName", "rating", "isVerified", "isHidden", "createdAtUtc"]
    },
    "SupportEnquiry": {
      "title": "SupportEnquiry",
      "description": "Public customer support enquiry routed to Decompress admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 40 },
        "bookingReference": { "type": "string", "maxLength": 30 },
        "message": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["open", "in_progress", "resolved"] },
        "createdAtUtc": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "name", "email", "message", "status", "createdAtUtc"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global configurable settings and feature flags.",
      "type": "object",
      "properties": {
        "supportEmail": { "type": "string", "maxLength": 160 },
        "supportPhone": { "type": "string", "maxLength": 60 },
        "supportHours": { "type": "string", "maxLength": 160 },
        "guestPaymentMode": { "type": "string", "enum": ["guest_checkout", "wallet_only"] },
        "walletEnabled": { "type": "boolean" },
        "defaultCurrency": { "type": "string", "maxLength": 10 },
        "defaultTimezone": { "type": "string", "maxLength": 64 }
      },
      "required": ["supportEmail", "supportPhone", "supportHours", "guestPaymentMode", "walletEnabled", "defaultCurrency", "defaultTimezone"]
    },
    "FAQTopic": {
      "title": "FAQTopic",
      "description": "Topic section grouping FAQ items.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 120 },
        "slug": { "type": "string", "maxLength": 120, "pattern": "^[a-z0-9\\-]+$" },
        "order": { "type": "number" }
      },
      "required": ["id", "title", "slug", "order"]
    },
    "FAQItem": {
      "title": "FAQItem",
      "description": "Frequently asked question and answer managed by admins without a deploy.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "topicId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "topicSlug": { "type": "string", "maxLength": 120 },
        "question": { "type": "string", "maxLength": 300 },
        "answer": { "type": "string", "maxLength": 2500 },
        "order": { "type": "number" },
        "isPublished": { "type": "boolean" },
        "requiresPolicyConfirmation": { "type": "boolean" }
      },
      "required": ["id", "topicId", "question", "answer", "order", "isPublished"]
    },
    "AddOn": {
      "title": "AddOn",
      "description": "Optional event planning and coordination add-on.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "fixedPriceMinor": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "isOptionalFixedPrice": { "type": "boolean" }
      },
      "required": ["id", "type", "name", "description", "currency", "isOptionalFixedPrice"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Public user account metadata."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Isolated PII and notification preferences for user account."
    },
    "/users/{userId}/favourites/{favouriteId}": {
      "schema": { "$ref": "#/entities/Favourite" },
      "description": "Saved favourite venues belonging to a verified registered user."
    },
    "/users/{userId}/wallet/{walletDocId}": {
      "schema": { "$ref": "#/entities/Wallet" },
      "description": "Local mirror of provider-backed wallet balance."
    },
    "/users/{userId}/walletTransactions/{txId}": {
      "schema": { "$ref": "#/entities/WalletTransaction" },
      "description": "Wallet funding, booking payment, refund, and reversal transactions."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminMember" },
      "description": "Trusted staff/admin membership records."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Decompress venue categories."
    },
    "/locations/{locationId}": {
      "schema": { "$ref": "#/entities/Location" },
      "description": "Lagos discovery locations (city, area, neighbourhood)."
    },
    "/facilities/{facilityId}": {
      "schema": { "$ref": "#/entities/Facility" },
      "description": "Venue facilities mapped to applicable categories."
    },
    "/experienceTags/{tagId}": {
      "schema": { "$ref": "#/entities/ExperienceTag" },
      "description": "Venue activity and experience tags."
    },
    "/venues/{venueId}": {
