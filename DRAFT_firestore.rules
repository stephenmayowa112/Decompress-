rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedSuperuser() {
      return isSignedIn() && (
        request.auth.token.email == 'stephenmayowa112@gmail.com' ||
        request.auth.token.email == 'onwukavivian9@gmail.com'
      );
    }

    function isAdmin() {
      return isBootstrappedSuperuser() || (
        isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSuperuser() {
      return isBootstrappedSuperuser() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.staffGroup == 'Superuser'
      );
    }

    // 3. Validation Blueprints
    function isValidUserPublic(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'accountType']) &&
        data.keys().hasOnly(['uid', 'name', 'accountType', 'companyName']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.uid == userId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.accountType is string && (data.accountType == 'personal' || data.accountType == 'corporate') &&
        (!('companyName' in data) || (data.companyName is string && data.companyName.size() <= 160));
    }

    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'googleLinked', 'emailVerified']) &&
        data.keys().hasOnly(['uid', 'email', 'phone', 'googleLinked', 'emailVerified', 'promotionalEmailsOptIn']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.uid == userId &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        data.googleLinked is bool &&
        data.emailVerified is bool &&
        (!('promotionalEmailsOptIn' in data) || data.promotionalEmailsOptIn is bool);
    }

    function isValidFavourite(data, userId, favouriteId) {
      return data.keys().hasAll(['id', 'userId', 'venueId', 'createdAtUtc']) &&
        data.keys().hasOnly(['id', 'userId', 'venueId', 'createdAtUtc']) &&
        data.id is string && data.id == favouriteId && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.venueId is string && data.venueId == favouriteId && data.venueId.size() >= 1 && data.venueId.size() <= 128 &&
        data.createdAtUtc is string && data.createdAtUtc.size() >= 10 && data.createdAtUtc.size() <= 40;
    }

    function isValidWallet(data, userId, walletDocId) {
      return data.keys().hasAll(['id', 'userId', 'balanceMinor', 'currency', 'providerAccountRef', 'updatedAtUtc']) &&
        data.keys().hasOnly(['id', 'userId', 'balanceMinor', 'currency', 'providerAccountRef', 'updatedAtUtc']) &&
        data.id is string && data.id == walletDocId && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.balanceMinor is number && data.balanceMinor >= 0 &&
        data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 10 &&
        data.providerAccountRef is string && data.providerAccountRef.size() >= 3 && data.providerAccountRef.size() <= 120 &&
        data.updatedAtUtc is string && data.updatedAtUtc.size() >= 10 && data.updatedAtUtc.size() <= 40;
    }

    function isValidWalletTransaction(data, userId, txId) {
      return data.keys().hasAll([
          'id', 'walletId', 'userId', 'type', 'amountMinor',
          'currency', 'status', 'providerReference', 'description', 'createdAtUtc'
        ]) &&
        data.keys().hasOnly([
          'id', 'walletId', 'userId', 'type', 'amountMinor',
          'currency', 'status', 'providerReference', 'bookingReference', 'description', 'createdAtUtc'
        ]) &&
        data.id is string && data.id == txId && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.walletId is string && data.walletId.size() >= 1 && data.walletId.size() <= 128 &&
        data.userId is string && data.userId == userId && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.type is string && (
          data.type == 'funding' || data.type == 'booking_payment' ||
          data.type == 'refund' || data.type == 'reversal'
        ) &&
        data.amountMinor is number && data.amountMinor >= 0 &&
        data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 10 &&
        data.status is string && (
          data.status == 'pending' || data.status == 'succeeded' ||
          data.status == 'failed' || data.status == 'refunded' || data.status == 'reversed'
        ) &&
        data.providerReference is string && data.providerReference.size() >= 3 && data.providerReference.size() <= 120 &&
        (!('bookingReference' in data) || (data.bookingReference is string && data.bookingReference.size() <= 20)) &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 300 &&
        data.createdAtUtc is string && data.createdAtUtc.size() >= 10 && data.createdAtUtc.size() <= 40;
    }

    function isValidBooking(data, bookingId) {
      return data.keys().hasAll([
          'id', 'reference', 'status', 'venueId', 'venueName', 'venueSlug',
          'userId', 'guestName', 'guestEmail', 'guestPhone', 'date',
          'preferredTime', 'guestCount', 'occasion', 'bookingType',
          'currency', 'createdAtUtc'
        ]) &&
        data.keys().hasOnly([
          'id', 'reference', 'status', 'venueId', 'venueName', 'venueSlug',
          'userId', 'guestName', 'guestEmail', 'guestPhone', 'date',
          'preferredTime', 'guestCount', 'occasion', 'bookingType',
          'specialRequests', 'eventServiceLevel', 'selectedAddOnIds',
          'amountDueMinor', 'currency', 'cancellationReason', 'reviewToken', 'createdAtUtc'
        ]) &&
        data.id is string && data.id == bookingId && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.reference is string && data.reference.size() == 10 && data.reference.matches('^DCP-[A-Z0-9]{6}$') &&
        data.status is string && (
          data.status == 'pending' ||
          data.status == 'approved' ||
          data.status == 'unavailable' ||
          data.status == 'confirmed' ||
          data.status == 'completed' ||
          data.status == 'cancelled'
        ) &&
        data.venueId is string && data.venueId.size() >= 1 && data.venueId.size() <= 128 &&
        data.venueName is string && data.venueName.size() >= 1 && data.venueName.size() <= 160 &&
        data.venueSlug is string && data.venueSlug.size() >= 1 && data.venueSlug.size() <= 160 && data.venueSlug.matches('^[a-z0-9\\-]+$') &&
        data.userId is string && data.userId.size() <= 128 &&
        data.guestName is string && data.guestName.size() >= 1 && data.guestName.size() <= 120 &&
        data.guestEmail is string && data.guestEmail.size() >= 3 && data.guestEmail.size() <= 160 &&
        data.guestPhone is string && data.guestPhone.size() >= 5 && data.guestPhone.size() <= 40 &&
        data.date is string && data.date.size() >= 8 && data.date.size() <= 20 &&
        data.preferredTime is string && data.preferredTime.size() >= 3 && data.preferredTime.size() <= 20 &&
        data.guestCount is number && data.guestCount >= 1 && data.guestCount <= 50000 &&
        data.occasion is string && data.occasion.size() >= 1 && data.occasion.size() <= 120 &&
        data.bookingType is string && (
          data.bookingType == 'table' || data.bookingType == 'group' || data.bookingType == 'private_hire'
        ) &&
        (!('specialRequests' in data) || (data.specialRequests is string && data.specialRequests.size() <= 1500)) &&
        (!('eventServiceLevel' in data) || (data.eventServiceLevel is string && data.eventServiceLevel.size() <= 80)) &&
        (!('selectedAddOnIds' in data) || (data.selectedAddOnIds is list && data.selectedAddOnIds.size() <= 10 && (data.selectedAddOnIds.size() == 0 || (data.selectedAddOnIds[0] is string && data.selectedAddOnIds[0].size() <= 128)))) &&
        (!('amountDueMinor' in data) || (data.amountDueMinor is number && data.amountDueMinor >= 0)) &&
        data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 10 &&
        (!('cancellationReason' in data) || (data.cancellationReason is string && data.cancellationReason.size() <= 500)) &&
        (!('reviewToken' in data) || (data.reviewToken is string && data.reviewToken.size() <= 80)) &&
        data.createdAtUtc is string && data.createdAtUtc.size() >= 10 && data.createdAtUtc.size() <= 40;
    }

    function isValidBookingHistory(data, bookingId, historyId) {
      return data.keys().hasAll(['id', 'bookingId', 'fromStatus', 'toStatus', 'actor', 'note', 'timestampUtc']) &&
        data.keys().hasOnly(['id', 'bookingId', 'fromStatus', 'toStatus', 'actor', 'note', 'timestampUtc']) &&
        data.id is string && data.id == historyId && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.bookingId is string && data.bookingId == bookingId && data.bookingId.size() >= 1 && data.bookingId.size() <= 128 &&
        data.fromStatus is string && data.fromStatus.size() >= 1 && data.fromStatus.size() <= 30 &&
        data.toStatus is string && data.toStatus.size() >= 1 && data.toStatus.size() <= 30 &&
        data.actor is string && data.actor.size() >= 1 && data.actor.size() <= 160 &&
        data.note is string && data.note.size() >= 1 && data.note.size() <= 500 &&
        data.timestampUtc is string && data.timestampUtc.size() >= 10 && data.timestampUtc.size() <= 40;
    }

    function isValidPayment(data, paymentId) {
      return data.keys().hasAll([
          'id', 'bookingId', 'bookingReference', 'provider', 'providerReference',
          'amountMinor', 'currency', 'status', 'method', 'guestPayToken', 'createdAtUtc'
        ]) &&
        data.keys().hasOnly([
          'id', 'bookingId', 'bookingReference', 'userId', 'provider', 'providerReference',
          'amountMinor', 'currency', 'status', 'method', 'guestPayToken', 'createdAtUtc'
        ]) &&
        data.id is string && data.id == paymentId && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.bookingId is string && data.bookingId.size() >= 1 && data.bookingId.size() <= 128 &&
        data.bookingReference is string && data.bookingReference.size() == 10 &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
        data.provider is string && data.provider.size() >= 1 && data.provider.size() <= 60 &&
        data.providerReference is string && data.providerReference.size() >= 1 && data.providerReference.size() <= 120 &&
        data.amountMinor is number && data.amountMinor >= 0 &&
        data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 10 &&
        data.status is string && (
          data.status == 'pending' || data.status == 'succeeded' ||
          data.status == 'failed' || data.status == 'refunded' || data.status == 'reversed'
        ) &&
        data.method is string && (
          data.method == 'guest_checkout_link' || data.method == 'wallet' || data.method == 'card_sandbox'
        ) &&
        data.guestPayToken is string && data.guestPayToken.size() >= 6 && data.guestPayToken.size() <= 80 &&
        data.createdAtUtc is string && data.createdAtUtc.size() >= 10 && data.createdAtUtc.size() <= 40;
    }

    function isValidInvoice(data, invoiceId) {
      return data.keys().hasAll([
          'id', 'bookingId', 'bookingReference', 'invoiceNumber', 'venueName',
          'eventDate', 'customerName', 'customerEmail', 'amountPaidMinor',
          'currency', 'status', 'issuedAtUtc'
        ]) &&
        data.keys().hasOnly([
          'id', 'bookingId', 'bookingReference', 'userId', 'invoiceNumber', 'venueName',
          'eventDate', 'customerName', 'customerEmail', 'companyName', 'lineItems',
          'discountOrFeeMinor', 'amountPaidMinor', 'currency', 'status', 'issuedAtUtc'
        ]) &&
        data.id is string && data.id == invoiceId && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.bookingId is string && data.bookingId.size() >= 1 && data.bookingId.size() <= 128 &&
        data.bookingReference is string && data.bookingReference.size() == 10 &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
        data.invoiceNumber is string && data.invoiceNumber.size() >= 4 && data.invoiceNumber.size() <= 40 &&
        data.venueName is string && data.venueName.size() >= 1 && data.venueName.size() <= 160 &&
        data.eventDate is string && data.eventDate.size() >= 8 && data.eventDate.size() <= 20 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 160 &&
        (!('companyName' in data) || (data.companyName is string && data.companyName.size() <= 160)) &&
        (!('lineItems' in data) || (data.lineItems is list && data.lineItems.size() <= 20)) &&
        (!('discountOrFeeMinor' in data) || data.discountOrFeeMinor is number) &&
        data.amountPaidMinor is number && data.amountPaidMinor >= 0 &&
        data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 10 &&
        data.status is string && (data.status == 'paid' || data.status == 'refunded') &&
        data.issuedAtUtc is string && data.issuedAtUtc.size() >= 10 && data.issuedAtUtc.size() <= 40;
    }

    function isValidSettlement(data, bookingId) {
      return data.keys().hasAll([
          'id', 'bookingId', 'bookingReference', 'customerAmountReceivedMinor',
          'venueBillAmountMinor', 'agreedDiscountMinor', 'decompressShareMinor',
          'amountPayableToVenueMinor', 'amountRetainedMinor', 'currency',
          'settlementStatus', 'updatedBy', 'updatedAtUtc'
        ]) &&
        data.keys().hasOnly([
          'id', 'bookingId', 'bookingReference', 'customerAmountReceivedMinor',
          'venueBillAmountMinor', 'venueBillFileName', 'agreedDiscountMinor',
          'decompressShareMinor', 'amountPayableToVenueMinor', 'amountRetainedMinor',
          'currency', 'settlementStatus', 'settledAtUtc', 'updatedBy', 'updatedAtUtc'
        ]) &&
        data.id is string && data.id == bookingId && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.bookingId is string && data.bookingId == bookingId && data.bookingId.size() >= 1 && data.bookingId.size() <= 128 &&
        data.bookingReference is string && data.bookingReference.size() == 10 &&
        data.customerAmountReceivedMinor is number && data.customerAmountReceivedMinor >= 0 &&
        data.venueBillAmountMinor is number && data.venueBillAmountMinor >= 0 &&
        (!('venueBillFileName' in data) || (data.venueBillFileName is string && data.venueBillFileName.size() <= 200)) &&
        data.agreedDiscountMinor is number &&
        data.decompressShareMinor is number &&
        data.amountPayableToVenueMinor is number &&
        data.amountRetainedMinor is number &&
        data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 10 &&
        data.settlementStatus is string && (
          data.settlementStatus == 'unreconciled' ||
          data.settlementStatus == 'pending_payout' ||
          data.settlementStatus == 'settled' ||
          data.settlementStatus == 'disputed'
        ) &&
        (!('settledAtUtc' in data) || (data.settledAtUtc is string && data.settledAtUtc.size() <= 40)) &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 160 &&
        data.updatedAtUtc is string && data.updatedAtUtc.size() >= 10 && data.updatedAtUtc.size() <= 40;
    }

    function isValidEventRequest(data, requestId) {
      return data.keys().hasAll([
          'id', 'reference', 'userId', 'guestName', 'guestEmail', 'guestPhone',
          'serviceLevel', 'occasion', 'date', 'location', 'guestCount',
          'budgetMinor', 'currency', 'assistanceNeeded', 'status', 'createdAtUtc'
        ]) &&
        data.keys().hasOnly([
          'id', 'reference', 'userId', 'guestName', 'guestEmail', 'guestPhone',
          'serviceLevel', 'occasion', 'date', 'location', 'guestCount',
          'budgetMinor', 'currency', 'assistanceNeeded', 'selectedAddOnIds',
          'status', 'quotedAmountMinor', 'notes', 'linkedBookingId', 'createdAtUtc'
        ]) &&
        data.id is string && data.id == requestId && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.reference is string && data.reference.size() >= 6 && data.reference.size() <= 20 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.guestName is string && data.guestName.size() >= 1 && data.guestName.size() <= 120 &&
        data.guestEmail is string && data.guestEmail.size() >= 3 && data.guestEmail.size() <= 160 &&
        data.guestPhone is string && data.guestPhone.size() >= 5 && data.guestPhone.size() <= 40 &&
        data.serviceLevel is string && (
          data.serviceLevel == 'event_planning_assistance' ||
          data.serviceLevel == 'on_the_day_coordination' ||
          data.serviceLevel == 'full_planning_and_coordination'
        ) &&
        data.occasion is string && data.occasion.size() >= 1 && data.occasion.size() <= 120 &&
        data.date is string && data.date.size() >= 8 && data.date.size() <= 20 &&
        data.location is string && data.location.size() >= 1 && data.location.size() <= 160 &&
        data.guestCount is number && data.guestCount >= 1 && data.guestCount <= 50000 &&
        data.budgetMinor is number && data.budgetMinor >= 0 &&
        data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 10 &&
        data.assistanceNeeded is string && data.assistanceNeeded.size() >= 1 && data.assistanceNeeded.size() <= 2000 &&
        (!('selectedAddOnIds' in data) || (data.selectedAddOnIds is list && data.selectedAddOnIds.size() <= 10 && (data.selectedAddOnIds.size() == 0 || (data.selectedAddOnIds[0] is string && data.selectedAddOnIds[0].size() <= 128)))) &&
        data.status is string && (
          data.status == 'new' || data.status == 'in_discussion' || data.status == 'quoted' ||
          data.status == 'accepted' || data.status == 'in_progress' ||
          data.status == 'completed' || data.status == 'declined'
        ) &&
        (!('quotedAmountMinor' in data) || (data.quotedAmountMinor is number && data.quotedAmountMinor >= 0)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1500)) &&
        (!('linkedBookingId' in data) || (data.linkedBookingId is string && data.linkedBookingId.size() <= 128)) &&
        data.createdAtUtc is string && data.createdAtUtc.size() >= 10 && data.createdAtUtc.size() <= 40;
    }

    function isValidReview(data, reviewId) {
      return data.keys().hasAll([
          'id', 'bookingId', 'bookingReference', 'venueId', 'venueName',
          'reviewerName', 'rating', 'isVerified', 'isHidden', 'createdAtUtc'
        ]) &&
        data.keys().hasOnly([
          'id', 'bookingId', 'bookingReference', 'venueId', 'venueName',
          'reviewerName', 'rating', 'venueFeedback', 'experienceFeedback',
          'isVerified', 'isHidden', 'createdAtUtc'
        ]) &&
        data.id is string && data.id == reviewId && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.bookingId is string && data.bookingId.size() >= 1 && data.bookingId.size() <= 128 &&
        data.bookingReference is string && data.bookingReference.size() == 10 &&
        data.venueId is string && data.venueId.size() >= 1 && data.venueId.size() <= 128 &&
        data.venueName is string && data.venueName.size() >= 1 && data.venueName.size() <= 160 &&
        data.reviewerName is string && data.reviewerName.size() >= 1 && data.reviewerName.size() <= 120 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        (!('venueFeedback' in data) || (data.venueFeedback is string && data.venueFeedback.size() <= 1500)) &&
        (!('experienceFeedback' in data) || (data.experienceFeedback is string && data.experienceFeedback.size() <= 1500)) &&
        data.isVerified == true &&
        data.isHidden is bool &&
        data.createdAtUtc is string && data.createdAtUtc.size() >= 10 && data.createdAtUtc.size() <= 40;
    }

    function isValidSupportEnquiry(data, enquiryId) {
      return data.keys().hasAll(['id', 'name', 'email', 'message', 'status', 'createdAtUtc']) &&
        data.keys().hasOnly(['id', 'name', 'email', 'phone', 'bookingReference', 'message', 'status', 'createdAtUtc']) &&
        data.id is string && data.id == enquiryId && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        (!('bookingReference' in data) || (data.bookingReference is string && data.bookingReference.size() <= 30)) &&
        data.message is string && data.message.size() >= 3 && data.message.size() <= 2000 &&
        data.status is string && (
          data.status == 'open' || data.status == 'in_progress' || data.status == 'resolved'
        ) &&
        data.createdAtUtc is string && data.createdAtUtc.size() >= 10 && data.createdAtUtc.size() <= 40;
    }

    function isValidAdminMember(data, adminId) {
      return data.keys().hasAll(['uid', 'email', 'staffGroup']) &&
        data.keys().hasOnly(['uid', 'email', 'staffGroup']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.uid == adminId &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.staffGroup is string && (
          data.staffGroup == 'Operations' ||
          data.staffGroup == 'Finance' ||
          data.staffGroup == 'Content & Support' ||
          data.staffGroup == 'Superuser'
        );
    }

    function isValidCategory(data, categoryId) {
      return data.keys().hasAll(['id', 'name', 'slug', 'description', 'order']) &&
        data.keys().hasOnly(['id', 'name', 'slug', 'description', 'iconName', 'order']) &&
        data.id is string && data.id == categoryId && data.id.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 100 && data.slug.matches('^[a-z0-9\\-]+$') &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 500 &&
        (!('iconName' in data) || (data.iconName is string && data.iconName.size() <= 50)) &&
        data.order is number;
    }

    function isValidLocation(data, locationId) {
      return data.keys().hasAll(['id', 'city', 'area', 'neighbourhood']) &&
        data.keys().hasOnly(['id', 'city', 'area', 'neighbourhood']) &&
        data.id is string && data.id == locationId && data.id.size() <= 128 &&
        data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
        data.area is string && data.area.size() >= 1 && data.area.size() <= 80 &&
        data.neighbourhood is string && data.neighbourhood.size() >= 1 && data.neighbourhood.size() <= 100;
    }

    function isValidFacility(data, facilityId) {
      return data.keys().hasAll(['id', 'name', 'slug', 'applicableCategorySlugs']) &&
        data.keys().hasOnly(['id', 'name', 'slug', 'applicableCategorySlugs']) &&
        data.id is string && data.id == facilityId && data.id.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 80 && data.slug.matches('^[a-z0-9\\-]+$') &&
        data.applicableCategorySlugs is list && data.applicableCategorySlugs.size() >= 1 && data.applicableCategorySlugs.size() <= 10 &&
        data.applicableCategorySlugs[0] is string && data.applicableCategorySlugs[0].size() <= 100;
    }

    function isValidExperienceTag(data, tagId) {
      return data.keys().hasAll(['id', 'name', 'slug', 'categorySlugs']) &&
        data.keys().hasOnly(['id', 'name', 'slug', 'categorySlugs']) &&
        data.id is string && data.id == tagId && data.id.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 80 && data.slug.matches('^[a-z0-9\\-]+$') &&
        data.categorySlugs is list && data.categorySlugs.size() >= 1 && data.categorySlugs.size() <= 10 &&
        data.categorySlugs[0] is string && data.categorySlugs[0].size() <= 100;
    }

    function isValidVenue(data, venueId) {
      return data.keys().hasAll([
          'id', 'name', 'slug', 'description', 'address', 'locationId',
          'setting', 'capacity', 'budgetMinMinor', 'budgetMaxMinor',
          'currency', 'budgetBasis', 'isFeatured', 'isPublished'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'slug', 'description', 'address', 'locationId',
          'city', 'area', 'neighbourhood', 'setting', 'capacity', 'openingHours',
          'budgetMinMinor', 'budgetMaxMinor', 'currency', 'budgetBasis',
          'categorySlugs', 'experienceTags', 'facilitySlugs', 'occasions',
          'bookingTypes', 'heroImageUrl', 'galleryImages', 'confirmedOfferText',
          'ratingAverage', 'reviewCount', 'isFeatured', 'isPublished'
        ]) &&
        data.id is string && data.id == venueId && data.id.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 160 && data.slug.matches('^[a-z0-9\\-]+$') &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 3000 &&
        data.address is string && data.address.size() >= 1 && data.address.size() <= 300 &&
        data.locationId is string && data.locationId.size() >= 1 && data.locationId.size() <= 128 &&
        (!('city' in data) || (data.city is string && data.city.size() <= 80)) &&
        (!('area' in data) || (data.area is string && data.area.size() <= 80)) &&
        (!('neighbourhood' in data) || (data.neighbourhood is string && data.neighbourhood.size() <= 100)) &&
        data.setting is string && (
          data.setting == 'indoor' || data.setting == 'outdoor' ||
          data.setting == 'rooftop' || data.setting == 'beachfront'
        ) &&
        data.capacity is number && data.capacity >= 1 && data.capacity <= 50000 &&
        (!('openingHours' in data) || (data.openingHours is string && data.openingHours.size() <= 300)) &&
        data.budgetMinMinor is number && data.budgetMinMinor >= 0 &&
        data.budgetMaxMinor is number && data.budgetMaxMinor >= data.budgetMinMinor &&
        data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 10 &&
        data.budgetBasis is string && (
          data.budgetBasis == 'per_person' || data.budgetBasis == 'per_table' || data.budgetBasis == 'total'
        ) &&
        (!('categorySlugs' in data) || (data.categorySlugs is list && data.categorySlugs.size() <= 7 && (data.categorySlugs.size() == 0 || (data.categorySlugs[0] is string && data.categorySlugs[0].size() <= 100)))) &&
        (!('experienceTags' in data) || (data.experienceTags is list && data.experienceTags.size() <= 20 && (data.experienceTags.size() == 0 || (data.experienceTags[0] is string && data.experienceTags[0].size() <= 80)))) &&
        (!('facilitySlugs' in data) || (data.facilitySlugs is list && data.facilitySlugs.size() <= 20 && (data.facilitySlugs.size() == 0 || (data.facilitySlugs[0] is string && data.facilitySlugs[0].size() <= 80)))) &&
        (!('occasions' in data) || (data.occasions is list && data.occasions.size() <= 15 && (data.occasions.size() == 0 || (data.occasions[0] is string && data.occasions[0].size() <= 80)))) &&
        (!('bookingTypes' in data) || (data.bookingTypes is list && data.bookingTypes.size() <= 5 && (data.bookingTypes.size() == 0 || (data.bookingTypes[0] is string && data.bookingTypes[0].size() <= 50)))) &&
        (!('heroImageUrl' in data) || (data.heroImageUrl is string && data.heroImageUrl.size() <= 4000)) &&
        (!('galleryImages' in data) || (data.galleryImages is list && data.galleryImages.size() <= 10 && (data.galleryImages.size() == 0 || (data.galleryImages[0] is string && data.galleryImages[0].size() <= 4000)))) &&
        (!('confirmedOfferText' in data) || (data.confirmedOfferText is string && data.confirmedOfferText.size() <= 400)) &&
        (!('ratingAverage' in data) || (data.ratingAverage is number && data.ratingAverage >= 0 && data.ratingAverage <= 5)) &&
        (!('reviewCount' in data) || (data.reviewCount is number && data.reviewCount >= 0)) &&
        data.isFeatured is bool &&
        data.isPublished is bool;
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll([
          'supportEmail', 'supportPhone', 'supportHours',
          'guestPaymentMode', 'walletEnabled', 'defaultCurrency', 'defaultTimezone'
        ]) &&
        data.keys().hasOnly([
          'supportEmail', 'supportPhone', 'supportHours',
          'guestPaymentMode', 'walletEnabled', 'defaultCurrency', 'defaultTimezone'
        ]) &&
        data.supportEmail is string && data.supportEmail.size() >= 3 && data.supportEmail.size() <= 160 &&
        data.supportPhone is string && data.supportPhone.size() >= 3 && data.supportPhone.size() <= 60 &&
        data.supportHours is string && data.supportHours.size() >= 3 && data.supportHours.size() <= 160 &&
        data.guestPaymentMode is string && (data.guestPaymentMode == 'guest_checkout' || data.guestPaymentMode == 'wallet_only') &&
        data.walletEnabled is bool &&
        data.defaultCurrency is string && data.defaultCurrency.size() >= 3 && data.defaultCurrency.size() <= 10 &&
        data.defaultTimezone is string && data.defaultTimezone.size() >= 2 && data.defaultTimezone.size() <= 64;
    }

    function isValidFAQTopic(data, topicId) {
      return data.keys().hasAll(['id', 'title', 'slug', 'order']) &&
        data.keys().hasOnly(['id', 'title', 'slug', 'order']) &&
        data.id is string && data.id == topicId && data.id.size() <= 128 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 120 && data.slug.matches('^[a-z0-9\\-]+$') &&
        data.order is number;
    }

    function isValidFAQItem(data, itemId) {
      return data.keys().hasAll(['id', 'topicId', 'question', 'answer', 'order', 'isPublished']) &&
        data.keys().hasOnly(['id', 'topicId', 'topicSlug', 'question', 'answer', 'order', 'isPublished', 'requiresPolicyConfirmation']) &&
        data.id is string && data.id == itemId && data.id.size() <= 128 &&
        data.topicId is string && data.topicId.size() >= 1 && data.topicId.size() <= 128 &&
        (!('topicSlug' in data) || (data.topicSlug is string && data.topicSlug.size() <= 120)) &&
        data.question is string && data.question.size() >= 1 && data.question.size() <= 300 &&
        data.answer is string && data.answer.size() >= 1 && data.answer.size() <= 2500 &&
        data.order is number &&
        data.isPublished is bool &&
        (!('requiresPolicyConfirmation' in data) || data.requiresPolicyConfirmation is bool);
    }

    function isValidAddOn(data, addOnId) {
      return data.keys().hasAll(['id', 'type', 'name', 'description', 'currency', 'isOptionalFixedPrice']) &&
        data.keys().hasOnly(['id', 'type', 'name', 'description', 'fixedPriceMinor', 'currency', 'isOptionalFixedPrice']) &&
        data.id is string && data.id == addOnId && data.id.size() <= 128 &&
        data.type is string && data.type.size() >= 1 && data.type.size() <= 100 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 500 &&
        (!('fixedPriceMinor' in data) || (data.fixedPriceMinor is number && data.fixedPriceMinor >= 0)) &&
        data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 10 &&
        data.isOptionalFixedPrice is bool;
    }

    // 4. Collection Match Blocks
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedSuperuser() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserPublic(incoming(), userId);
      allow update: if isValidId(userId) && isValidUserPublic(incoming(), userId) && (
        isAdmin() || (
          isOwner(userId) &&
          incoming().uid == existing().uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'accountType', 'companyName'])
        )
      );
      allow delete: if isValidId(userId) && isSuperuser();

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow list: if isValidId(userId) && (isOwner(userId) || isBootstrappedSuperuser());
        allow create: if isValidId(userId) && isValidId(docId) && docId == 'info' &&
          isOwner(userId) &&
          isValidUserPrivate(incoming(), userId) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId) && isValidId(docId) && docId == 'info' &&
          isValidUserPrivate(incoming(), userId) &&
          exists(/databases/$(database)/documents/users/$(userId)) && (
            isAdmin() || (
              isOwner(userId) &&
              incoming().uid == existing().uid &&
              incoming().email == existing().email &&
              incoming().diff(existing()).affectedKeys().hasOnly(['phone', 'promotionalEmailsOptIn', 'googleLinked', 'emailVerified'])
            )
          );
        allow delete: if isValidId(userId) && isValidId(docId) && isSuperuser();
      }

      match /favourites/{favouriteId} {
        allow get: if isValidId(userId) && isValidId(favouriteId) && (isOwner(userId) || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow list: if isValidId(userId) && (isOwner(userId) || isBootstrappedSuperuser()) &&
          resource.data.userId == userId;
        allow create: if isValidId(userId) && isValidId(favouriteId) &&
          isOwner(userId) &&
          isValidFavourite(incoming(), userId, favouriteId) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(favouriteId) && (isOwner(userId) || isAdmin());
      }

      match /wallet/{walletDocId} {
        allow get: if isValidId(userId) && isValidId(walletDocId) && (isOwner(userId) || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow list: if isValidId(userId) && (isOwner(userId) || isBootstrappedSuperuser()) &&
          resource.data.userId == userId;
        allow create: if isValidId(userId) && isValidId(walletDocId) && walletDocId == 'primary' &&
          (isOwner(userId) || isAdmin()) &&
          isValidWallet(incoming(), userId, walletDocId) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId) && isValidId(walletDocId) && walletDocId == 'primary' &&
          isValidWallet(incoming(), userId, walletDocId) &&
          exists(/databases/$(database)/documents/users/$(userId)) && (
            isAdmin() || (
              isOwner(userId) &&
              incoming().id == existing().id &&
              incoming().userId == existing().userId &&
              incoming().diff(existing()).affectedKeys().hasOnly(['balanceMinor', 'updatedAtUtc'])
            )
          );
        allow delete: if isValidId(userId) && isValidId(walletDocId) && isSuperuser();
      }

      match /walletTransactions/{txId} {
        allow get: if isValidId(userId) && isValidId(txId) && (isOwner(userId) || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow list: if isValidId(userId) && (isOwner(userId) || isBootstrappedSuperuser()) &&
          resource.data.userId == userId;
        allow create: if isValidId(userId) && isValidId(txId) &&
          (isOwner(userId) || isAdmin()) &&
          isValidWalletTransaction(incoming(), userId, txId) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId) && isValidId(txId) &&
          isValidWalletTransaction(incoming(), userId, txId) &&
          isAdmin() &&
          incoming().id == existing().id &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status']);
        allow delete: if isValidId(userId) && isValidId(txId) && isSuperuser();
      }
    }

    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && (
        isAdmin() || (
          isSignedIn() && (
            existing().userId == request.auth.uid ||
            (existing().userId == '' && existing().guestEmail == request.auth.token.email.lower())
          )
        )
      );
      allow list: if isBootstrappedSuperuser() || (
        isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          (resource.data.userId == '' && resource.data.guestEmail == request.auth.token.email.lower())
        )
      );
      allow create: if isValidId(bookingId) && isValidBooking(incoming(), bookingId) &&
        incoming().status == 'pending' && (
          (isSignedIn() && incoming().userId == request.auth.uid) ||
          isAdmin()
        );
      allow update: if isValidId(bookingId) && isValidBooking(incoming(), bookingId) && (
        isAdmin() || (
          // Action 1: Attach unowned guest booking strictly on verified email match
          isSignedIn() &&
          existing().userId == '' &&
          existing().guestEmail == request.auth.token.email.lower() &&
          incoming().userId == request.auth.uid &&
          incoming().id == existing().id &&
          incoming().reference == existing().reference &&
          incoming().status == existing().status &&
          incoming().guestEmail == existing().guestEmail &&
          incoming().diff(existing()).affectedKeys().hasOnly(['userId'])
        ) || (
          // Action 2: Verified owner confirms approved booking after payment
          isSignedIn() &&
          existing().userId == request.auth.uid &&
          existing().status == 'approved' &&
          incoming().status == 'confirmed' &&
          incoming().id == existing().id &&
          incoming().reference == existing().reference &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        )
      );
      allow delete: if isValidId(bookingId) && isSuperuser();

      match /history/{historyId} {
        allow get: if isValidId(bookingId) && isValidId(historyId) && (
          isAdmin() || (
            isSignedIn() &&
            exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId == request.auth.uid
          )
        );
        allow list: if isValidId(bookingId) && isBootstrappedSuperuser();
        allow create: if isValidId(bookingId) && isValidId(historyId) &&
          isValidBookingHistory(incoming(), bookingId, historyId) &&
          exists(/databases/$(database)/documents/bookings/$(bookingId)) && (
            isAdmin() || (
              isSignedIn() &&
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId == request.auth.uid
            )
          );
        allow update: if false;
        allow delete: if isValidId(bookingId) && isValidId(historyId) && isSuperuser();
      }
    }

    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && (
        isAdmin() || (isSignedIn() && existing().userId == request.auth.uid)
      );
      allow list: if isBootstrappedSuperuser() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
      allow create: if isValidId(paymentId) && isValidPayment(incoming(), paymentId) && (
        isAdmin() || (isSignedIn() && incoming().userId == request.auth.uid)
      );
      allow update: if isValidId(paymentId) && isValidPayment(incoming(), paymentId) && (
        isAdmin() || (
          isSignedIn() &&
          existing().userId == request.auth.uid &&
          existing().status == 'pending' &&
          incoming().status == 'succeeded' &&
          incoming().id == existing().id &&
          incoming().amountMinor == existing().amountMinor &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'method'])
        )
      );
      allow delete: if isValidId(paymentId) && isSuperuser();
    }

    match /invoices/{invoiceId} {
      allow get: if isValidId(invoiceId) && (
        isAdmin() || (isSignedIn() && existing().userId == request.auth.uid)
      );
      allow list: if isBootstrappedSuperuser() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
      allow create: if isValidId(invoiceId) && isValidInvoice(incoming(), invoiceId) && (
        isAdmin() || (isSignedIn() && incoming().userId == request.auth.uid)
      );
      allow update: if isValidId(invoiceId) && isValidInvoice(incoming(), invoiceId) &&
        isAdmin() &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isValidId(invoiceId) && isSuperuser();
    }

    // Commercial Settlements: STRICTLY ADMIN ONLY — Customers NEVER see these records (Section 9)
    match /settlements/{bookingId} {
      allow get: if isValidId(bookingId) && isAdmin();
      allow list: if isBootstrappedSuperuser();
      allow create: if isValidId(bookingId) && isAdmin() && isValidSettlement(incoming(), bookingId);
      allow update: if isValidId(bookingId) && isValidSettlement(incoming(), bookingId) &&
        isAdmin() &&
        incoming().id == existing().id &&
        incoming().bookingId == existing().bookingId &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'customerAmountReceivedMinor', 'venueBillAmountMinor', 'venueBillFileName',
          'agreedDiscountMinor', 'decompressShareMinor', 'amountPayableToVenueMinor',
          'amountRetainedMinor', 'settlementStatus', 'settledAtUtc', 'updatedBy', 'updatedAtUtc'
        ]);
      allow delete: if isValidId(bookingId) && isSuperuser();
    }

    match /eventPlanningRequests/{requestId} {
      allow get: if isValidId(requestId) && (
        isAdmin() || (isSignedIn() && existing().userId == request.auth.uid)
      );
      allow list: if isBootstrappedSuperuser() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
      allow create: if isValidId(requestId) && isValidEventRequest(incoming(), requestId) &&
        incoming().status == 'new' && (
          isAdmin() || (isSignedIn() && incoming().userId == request.auth.uid)
        );
      allow update: if isValidId(requestId) && isValidEventRequest(incoming(), requestId) &&
        isAdmin() &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'quotedAmountMinor', 'notes']);
      allow delete: if isValidId(requestId) && isSuperuser();
    }

    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (existing().isHidden == false || isAdmin());
      allow list: if resource.data.isHidden == false || isBootstrappedSuperuser();
      allow create: if isValidId(reviewId) && isValidReview(incoming(), reviewId) &&
        incoming().isVerified == true &&
        incoming().isHidden == false && (
          isAdmin() || (
            isSignedIn() &&
            exists(/databases/$(database)/documents/bookings/$(incoming().bookingId)) &&
            get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.status == 'completed' &&
            get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.userId == request.auth.uid
          )
        );
      allow update: if isValidId(reviewId) && isValidReview(incoming(), reviewId) &&
        isAdmin() &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly(['isHidden']);
      allow delete: if isValidId(reviewId) && isSuperuser();
    }

    match /supportEnquiries/{enquiryId} {
      allow get: if isValidId(enquiryId) && isAdmin();
      allow list: if isBootstrappedSuperuser();
      allow create: if isValidId(enquiryId) && isValidSupportEnquiry(incoming(), enquiryId) &&
        incoming().status == 'open' && isSignedIn();
      allow update: if isValidId(enquiryId) && isValidSupportEnquiry(incoming(), enquiryId) &&
        isAdmin() &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isValidId(enquiryId) && isSuperuser();
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isBootstrappedSuperuser() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isValidId(adminId) && isSuperuser() && isValidAdminMember(incoming(), adminId);
      allow update: if isValidId(adminId) && isValidAdminMember(incoming(), adminId) &&
        isSuperuser() &&
        incoming().uid == existing().uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'staffGroup']);
      allow delete: if isValidId(adminId) && isSuperuser();
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if resource.data.order >= 0;
      allow create: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming(), categoryId);
      allow update: if isValidId(categoryId) && isValidCategory(incoming(), categoryId) && isAdmin() &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'description', 'iconName', 'order']);
      allow delete: if isValidId(categoryId) && isSuperuser();
    }

    match /locations/{locationId} {
      allow get: if isValidId(locationId);
      allow list: if resource.data.city is string;
      allow create: if isValidId(locationId) && isAdmin() && isValidLocation(incoming(), locationId);
      allow update: if isValidId(locationId) && isValidLocation(incoming(), locationId) && isAdmin() &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly(['city', 'area', 'neighbourhood']);
      allow delete: if isValidId(locationId) && isSuperuser();
    }

    match /facilities/{facilityId} {
      allow get: if isValidId(facilityId);
      allow list: if resource.data.name is string;
      allow create: if isValidId(facilityId) && isAdmin() && isValidFacility(incoming(), facilityId);
      allow update: if isValidId(facilityId) && isValidFacility(incoming(), facilityId) && isAdmin() &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'applicableCategorySlugs']);
      allow delete: if isValidId(facilityId) && isSuperuser();
    }

    match /experienceTags/{tagId} {
      allow get: if isValidId(tagId);
      allow list: if resource.data.name is string;
      allow create: if isValidId(tagId) && isAdmin() && isValidExperienceTag(incoming(), tagId);
      allow update: if isValidId(tagId) && isValidExperienceTag(incoming(), tagId) && isAdmin() &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'categorySlugs']);
      allow delete: if isValidId(tagId) && isSuperuser();
    }

    match /venues/{venueId} {
      allow get: if isValidId(venueId) && (existing().isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isBootstrappedSuperuser();
      allow create: if isValidId(venueId) && isAdmin() && isValidVenue(incoming(), venueId) &&
        exists(/databases/$(database)/documents/locations/$(incoming().locationId));
      allow update: if isValidId(venueId) && isValidVenue(incoming(), venueId) && isAdmin() &&
        incoming().id == existing().id &&
        exists(/databases/$(database)/documents/locations/$(incoming().locationId)) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'slug', 'description', 'address', 'locationId',
          'city', 'area', 'neighbourhood', 'setting', 'capacity', 'openingHours',
          'budgetMinMinor', 'budgetMaxMinor', 'currency', 'budgetBasis',
          'categorySlugs', 'experienceTags', 'facilitySlugs', 'occasions',
          'bookingTypes', 'heroImageUrl', 'galleryImages', 'confirmedOfferText',
          'ratingAverage', 'reviewCount', 'isFeatured', 'isPublished'
        ]);
      allow delete: if isValidId(venueId) && isSuperuser();
    }

    match /siteSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if resource.data.defaultCurrency is string;
      allow create: if isValidId(settingId) && isAdmin() && isValidSiteSettings(incoming());
      allow update: if isValidId(settingId) && isValidSiteSettings(incoming()) && isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'supportEmail', 'supportPhone', 'supportHours',
          'guestPaymentMode', 'walletEnabled', 'defaultCurrency', 'defaultTimezone'
        ]);
      allow delete: if isValidId(settingId) && isSuperuser();
    }

    match /faqTopics/{topicId} {
      allow get: if isValidId(topicId);
      allow list: if resource.data.order >= 0;
      allow create: if isValidId(topicId) && isAdmin() && isValidFAQTopic(incoming(), topicId);
      allow update: if isValidId(topicId) && isValidFAQTopic(incoming(), topicId) && isAdmin() &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'slug', 'order']);
      allow delete: if isValidId(topicId) && isSuperuser();
    }

    match /faqItems/{itemId} {
      allow get: if isValidId(itemId) && (existing().isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isBootstrappedSuperuser();
      allow create: if isValidId(itemId) && isAdmin() && isValidFAQItem(incoming(), itemId) &&
        exists(/databases/$(database)/documents/faqTopics/$(incoming().topicId));
      allow update: if isValidId(itemId) && isValidFAQItem(incoming(), itemId) && isAdmin() &&
        incoming().id == existing().id &&
        exists(/databases/$(database)/documents/faqTopics/$(incoming().topicId)) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'topicId', 'topicSlug', 'question', 'answer', 'order', 'isPublished', 'requiresPolicyConfirmation'
        ]);
      allow delete: if isValidId(itemId) && isSuperuser();
    }

    match /addOns/{addOnId} {
      allow get: if isValidId(addOnId);
      allow list: if resource.data.currency is string;
      allow create: if isValidId(addOnId) && isAdmin() && isValidAddOn(incoming(), addOnId);
      allow update: if isValidId(addOnId) && isValidAddOn(incoming(), addOnId) && isAdmin() &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'type', 'name', 'description', 'fixedPriceMinor', 'currency', 'isOptionalFixedPrice'
        ]);
      allow delete: if isValidId(addOnId) && isSuperuser();
    }
  }
}
