# APP_URL: Canonical production URL where Decompress is hosted.
APP_URL="https://decompress.ng"

# DECOMPRESS PLATFORM DEFAULTS
DEFAULT_CURRENCY="NGN"
DEFAULT_TIMEZONE="Africa/Lagos"
GUEST_PAYMENT_MODE="guest_checkout"
WALLET_ENABLED="true"

# PAYMENTS (Set PAYMENT_PROVIDER to "paystack" or "flutterwave" for live payments,
# and set ALLOW_SANDBOX_SIGNING="false" in production)
PAYMENT_PROVIDER="mock_sandbox"
ALLOW_SANDBOX_SIGNING="false"
PAYMENT_WEBHOOK_SECRET=""

# TRANSACTIONAL EMAIL PROVIDER (Server-side secret key)
EMAIL_PROVIDER_API_KEY=""
